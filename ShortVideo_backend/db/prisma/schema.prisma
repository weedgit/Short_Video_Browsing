generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String     @map("password_hash")
  username     String     @unique
  displayName  String     @map("display_name")
  avatarUrl    String?    @map("avatar_url")
  bio          String?
  role         UserRole   @default(USER)
  status       UserStatus @default(ACTIVE)
  languageCode String     @default("ko") @map("language_code")
  countryCode  String?    @map("country_code")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  deletedAt    DateTime?  @map("deleted_at")

  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  devices             UserDevice[]
  videos              Video[]
  feedImpressions     FeedImpression[]
  playbackEvents      PlaybackEvent[]
  uploadSessions      UploadSession[]

  @@map("users")
}

enum UploadStatus {
  DRAFT
  UPLOADING
  UPLOADED
  PROCESSING
  PUBLISHED
  FAILED
}

enum VideoStatus {
  PROCESSING
  READY
  FAILED
  DELETED
}

model Video {
  id                String      @id @default(cuid())
  userId            String      @map("user_id")
  description       String      @default("")
  durationMs        Int         @default(0) @map("duration_ms")
  status            VideoStatus @default(PROCESSING)
  cloudflareAssetId String?     @map("cloudflare_asset_id")
  streamUrl         String?     @map("stream_url")
  hlsUrl            String?     @map("hls_url")
  category          String?
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")
  deletedAt         DateTime?   @map("deleted_at")

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  hashtags         VideoHashtag[]
  feedImpressions  FeedImpression[]
  playbackEvents   PlaybackEvent[]
  uploadSession    UploadSession?

  @@index([status, createdAt, id])
  @@index([userId])
  @@map("videos")
}

model UploadSession {
  id                 String       @id @default(cuid())
  userId             String       @map("user_id")
  videoId            String       @unique @map("video_id")
  status             UploadStatus @default(DRAFT)
  mimeType           String       @map("mime_type")
  fileSizeBytes      BigInt       @map("file_size_bytes")
  durationMs         Int?         @map("duration_ms")
  uploadUrl          String       @map("upload_url")
  uploadTokenHash    String       @unique @map("upload_token_hash")
  uploadUrlExpiresAt DateTime     @map("upload_url_expires_at")
  uploadUrlUsedAt    DateTime?    @map("upload_url_used_at")
  bytesUploaded      BigInt       @default(0) @map("bytes_uploaded")
  cloudflareAssetId  String?      @map("cloudflare_asset_id")
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("upload_sessions")
}

model WebhookEvent {
  id          String   @id @default(cuid())
  provider    String
  eventId     String   @unique @map("event_id")
  payloadHash String   @map("payload_hash")
  processedAt DateTime @default(now()) @map("processed_at")

  @@index([provider, processedAt])
  @@map("webhook_events")
}

model VideoHashtag {
  id      String @id @default(cuid())
  videoId String @map("video_id")
  tag     String

  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([videoId, tag])
  @@index([tag])
  @@map("video_hashtags")
}

model FeedImpression {
  id          String   @id @default(cuid())
  videoId     String   @map("video_id")
  userId      String?  @map("user_id")
  deviceId    String?  @map("device_id")
  impressedAt DateTime @default(now()) @map("impressed_at")

  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)
  user  User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, impressedAt])
  @@index([deviceId, impressedAt])
  @@index([videoId])
  @@map("feed_impressions")
}

model PlaybackEvent {
  id         String   @id @default(cuid())
  videoId    String   @map("video_id")
  userId     String?  @map("user_id")
  deviceId   String?  @map("device_id")
  eventType  String   @map("event_type")
  positionMs Int      @default(0) @map("position_ms")
  occurredAt DateTime @map("occurred_at")
  createdAt  DateTime @default(now()) @map("created_at")

  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)
  user  User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([videoId, occurredAt])
  @@index([userId, occurredAt])
  @@index([deviceId, occurredAt])
  @@map("playback_events")
}

model UserDevice {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  deviceId   String   @map("device_id")
  platform   String   @default("android")
  appVersion String?  @map("app_version")
  lastSeenAt DateTime @default(now()) @map("last_seen_at")
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceId])
  @@index([userId])
  @@map("user_devices")
}

model RefreshToken {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  replacedBy String?   @map("replaced_by")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}
