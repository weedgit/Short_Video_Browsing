generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String     @map("password_hash")
  username     String     @unique
  displayName  String     @map("display_name")
  avatarUrl    String?    @map("avatar_url")
  bio          String?
  role         UserRole   @default(USER)
  status       UserStatus @default(ACTIVE)
  languageCode String     @default("ko") @map("language_code")
  countryCode  String?    @map("country_code")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  deletedAt    DateTime?  @map("deleted_at")

  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  devices             UserDevice[]
  videos              Video[]
  feedImpressions     FeedImpression[]
  playbackEvents      PlaybackEvent[]
  uploadSessions      UploadSession[]
  videoLikes          VideoLike[]
  videoComments       VideoComment[]
  videoSaves          VideoSave[]
  reports             Report[]
  announcements       Announcement[]
  notifications       Notification[]      @relation("UserNotifications")
  actedNotifications  Notification[]      @relation("UserNotificationActor")
  followers           Follow[]            @relation("Following")
  following           Follow[]            @relation("Follower")

  @@map("users")
}

enum UploadStatus {
  DRAFT
  UPLOADING
  UPLOADED
  PROCESSING
  PUBLISHED
  FAILED
}

enum VideoStatus {
  PROCESSING
  READY
  FAILED
  DELETED
}

model Video {
  id                String      @id @default(cuid())
  userId            String      @map("user_id")
  description       String      @default("")
  durationMs        Int         @default(0) @map("duration_ms")
  status            VideoStatus @default(PROCESSING)
  cloudflareAssetId String?     @map("cloudflare_asset_id")
  streamUrl         String?     @map("stream_url")
  hlsUrl            String?     @map("hls_url")
  category          String?
  thumbnailUrl      String?     @map("thumbnail_url")
  likeCount         Int         @default(0) @map("like_count")
  commentCount      Int         @default(0) @map("comment_count")
  shareCount        Int         @default(0) @map("share_count")
  musicLabel        String?     @map("music_label")
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")
  deletedAt         DateTime?   @map("deleted_at")

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  hashtags         VideoHashtag[]
  feedImpressions  FeedImpression[]
  playbackEvents   PlaybackEvent[]
  uploadSession    UploadSession?
  likes            VideoLike[]
  comments         VideoComment[]
  saves            VideoSave[]
  notifications    Notification[]

  @@index([status, createdAt, id])
  @@index([userId])
  @@map("videos")
}

model UploadSession {
  id                 String       @id @default(cuid())
  userId             String       @map("user_id")
  videoId            String       @unique @map("video_id")
  status             UploadStatus @default(DRAFT)
  mimeType           String       @map("mime_type")
  fileSizeBytes      BigInt       @map("file_size_bytes")
  durationMs         Int?         @map("duration_ms")
  uploadUrl          String       @map("upload_url")
  uploadTokenHash    String       @unique @map("upload_token_hash")
  uploadUrlExpiresAt DateTime     @map("upload_url_expires_at")
  uploadUrlUsedAt    DateTime?    @map("upload_url_used_at")
  bytesUploaded      BigInt       @default(0) @map("bytes_uploaded")
  cloudflareAssetId  String?      @map("cloudflare_asset_id")
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("upload_sessions")
}

model WebhookEvent {
  id          String   @id @default(cuid())
  provider    String
  eventId     String   @unique @map("event_id")
  payloadHash String   @map("payload_hash")
  processedAt DateTime @default(now()) @map("processed_at")

  @@index([provider, processedAt])
  @@map("webhook_events")
}

model VideoHashtag {
  id      String @id @default(cuid())
  videoId String @map("video_id")
  tag     String

  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([videoId, tag])
  @@index([tag])
  @@map("video_hashtags")
}

model FeedImpression {
  id          String   @id @default(cuid())
  videoId     String   @map("video_id")
  userId      String?  @map("user_id")
  deviceId    String?  @map("device_id")
  impressedAt DateTime @default(now()) @map("impressed_at")

  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)
  user  User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, impressedAt])
  @@index([deviceId, impressedAt])
  @@index([videoId])
  @@map("feed_impressions")
}

model PlaybackEvent {
  id         String   @id @default(cuid())
  videoId    String   @map("video_id")
  userId     String?  @map("user_id")
  deviceId   String?  @map("device_id")
  eventType  String   @map("event_type")
  positionMs Int      @default(0) @map("position_ms")
  occurredAt DateTime @map("occurred_at")
  createdAt  DateTime @default(now()) @map("created_at")

  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)
  user  User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([videoId, occurredAt])
  @@index([userId, occurredAt])
  @@index([deviceId, occurredAt])
  @@map("playback_events")
}

model UserDevice {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  deviceId   String   @map("device_id")
  platform   String   @default("android")
  appVersion String?  @map("app_version")
  fcmToken   String?  @map("fcm_token")
  lastSeenAt DateTime @default(now()) @map("last_seen_at")
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceId])
  @@index([userId])
  @@map("user_devices")
}

model RefreshToken {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  replacedBy String?   @map("replaced_by")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model VideoLike {
  id        String   @id @default(cuid())
  videoId   String   @map("video_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([videoId, userId])
  @@index([userId])
  @@map("video_likes")
}

model VideoComment {
  id        String   @id @default(cuid())
  videoId   String   @map("video_id")
  userId    String   @map("user_id")
  text      String
  createdAt DateTime @default(now()) @map("created_at")

  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([videoId, createdAt])
  @@index([userId])
  @@map("video_comments")
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String   @map("follower_id")
  followingId String   @map("following_id")
  createdAt   DateTime @default(now()) @map("created_at")

  follower  User @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId])
  @@map("follows")
}

model VideoSave {
  id        String   @id @default(cuid())
  videoId   String   @map("video_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([videoId, userId])
  @@index([userId])
  @@map("video_saves")
}

enum ReportTargetType {
  VIDEO
  USER
  COMMENT
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

model Report {
  id         String           @id @default(cuid())
  reporterId String           @map("reporter_id")
  targetType ReportTargetType @map("target_type")
  targetId   String           @map("target_id")
  reason     String
  status     ReportStatus     @default(OPEN)
  createdAt  DateTime         @default(now()) @map("created_at")
  resolvedAt DateTime?        @map("resolved_at")

  reporter User @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([targetType, targetId])
  @@map("reports")
}

model Announcement {
  id          String    @id @default(cuid())
  title       String
  body        String
  createdById String?   @map("created_by_id")
  publishedAt DateTime? @map("published_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  isActive    Boolean   @default(true) @map("is_active")

  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([isActive, createdAt])
  @@map("announcements")
}

model Notification {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  type        String
  title       String
  body        String
  isRead      Boolean  @default(false) @map("is_read")
  videoId     String?  @map("video_id")
  actorUserId String?  @map("actor_user_id")
  createdAt   DateTime @default(now()) @map("created_at")

  user      User   @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  video     Video? @relation(fields: [videoId], references: [id], onDelete: SetNull)
  actorUser User?  @relation("UserNotificationActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([userId, isRead])
  @@map("notifications")
}
